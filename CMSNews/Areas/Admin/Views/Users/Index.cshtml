@model IEnumerable<CMSNews.Models.ViewModels.UserViewModel>

@{
    ViewBag.Title = "پنل مدیریت کاربران";
}

<div class="container py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">مدیریت کاربران  </h2>
            <p class="text-muted mb-0">فهرست اطلاعات ثبت‌شده</p>
        </div>
       
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.MobileNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Password)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.RegisteDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.IsActive)
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MobileNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Password)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RegisteDate)
                                </td>
                                <td>
                                       @(item.IsActive ? "فعال" : "غیرفعال")
                                </td>
                                <td class="text-center text-nowrap">
                                    @Html.ActionLink("ویرایش", "Edit", new { id = item.UserId },
                                        new { @class = "btn btn-sm btn-outline-warning ms-1" })
                                    @Html.ActionLink("جزئیات", "Details", new { id = item.UserId },
                                        new { @class = "btn btn-sm btn-outline-info ms-1" })
                                    @Html.ActionLink("حذف", "Delete", new { id = item.UserId },
                                        new { @class = "btn btn-sm btn-outline-danger" })
                                </td>
                            </tr>
                        }

                </table>
            </div>
        </div>
    </div>
</div>