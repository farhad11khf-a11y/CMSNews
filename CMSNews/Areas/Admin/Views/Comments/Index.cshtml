@model IEnumerable<CMSNews.Models.ViewModels.CommentsViewMdel>

@{
    ViewBag.Title = "مدیریت کامنت کاربران";
}

<div class="container py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">کامنت کاربران</h2>
            <p class="text-muted mb-0">فهرست کامنت ثبت‌شده</p>
        </div>
        <div>
            @Html.ActionLink("ثبت مورد جدید", "Create", null,
                new { @class = "btn btn-primary px-4" })
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>
                               عنوان خبر
                            </th>
                            @*<th>
                                @Html.DisplayNameFor(model => model.CommentText)
                            </th>*@
                            <th>
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            @*<th>
                                @Html.DisplayNameFor(model => model.Email)
                            </th>*@
                            @*<th>
                                @Html.DisplayNameFor(model => model.RegisterDate)
                            </th>*@
                            <th>
                                @Html.DisplayNameFor(model => model.IsActive)
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.News.NewsTitle)
                                </td>
                                @*<td>
                                    @Html.DisplayFor(modelItem => item.CommentText)
                                </td>*@
                                <td>
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                @*<td>
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RegisterDate)
                                </td>*@
                                <td>
                                    @(item.IsActive?"غیرفعال":"فعال")
                                    @*@Html.DisplayFor(modelItem => item.IsActive)*@
                                </td>
                                <td class="text-center text-nowrap">
                                    @Html.ActionLink("ویرایش", "Edit", new { id = item.CommentId },
                                        new { @class = "btn btn-sm btn-outline-warning ms-1" })
                                    @Html.ActionLink("جزئیات", "Details", new { id = item.CommentId },
                                        new { @class = "btn btn-sm btn-outline-info ms-1" })
                                    @Html.ActionLink("حذف", "Delete", new { id = item.CommentId },
                                        new { @class = "btn btn-sm btn-outline-danger" })
                                </td>
                            </tr>
                        }

                </table>
            </div>
        </div>
    </div>
</div>