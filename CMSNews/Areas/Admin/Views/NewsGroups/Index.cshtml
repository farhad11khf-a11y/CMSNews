@model IEnumerable<CMSNews.Models.ViewModels.NewsGroupsViewModel>

@{
    ViewBag.Title = "مدیریت گروه‌های خبری";
}

<div class="container py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">مدیریت Index</h2>
            <p class="text-muted mb-0">فهرست اطلاعات ثبت‌شده</p>
        </div>
        <div>
            @Html.ActionLink("ثبت مورد جدید", "Create", null,
                new { @class = "btn btn-primary px-4" })
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.ImageName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NewsGroupTitle)
                            </th>

                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>
                                @*@Html.DisplayFor(modelItem => item.ImageName)*@
                                <img src="~/Images/news.group/@item.ImageName" class="img60" alt="Alternate Text" />
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.NewsGroupTitle)
                            </td>

                            <td class="text-center text-nowrap">
                                @Html.ActionLink("ویرایش", "Edit", new { id = item.NewsGroupId },
                                    new { @class = "btn btn-sm btn-outline-warning ms-1" })
                                @Html.ActionLink("جزئیات", "Details", new { id = item.NewsGroupId },
                                    new { @class = "btn btn-sm btn-outline-info ms-1" })
                                @Html.ActionLink("حذف", "Delete", new { id = item.NewsGroupId },
                                    new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>