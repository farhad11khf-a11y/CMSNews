@model CMSNews.Models.ViewModels.NewsGroupsViewModel

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>


@using (Html.BeginForm("Edit", "NewsGroups", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>NewsGroup</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.NewsGroupId)

        <div class="form-group">
            @Html.LabelFor(model => model.NewsGroupTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NewsGroupTitle, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NewsGroupTitle, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ImageName, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.ImageName, new { htmlAttributes = new { @class = "form-control" } })

                <img src="~/Images/news.group/@Model.ImageName" id="imgPrev" class="img60" alt="Alternate Text" />
                <input type="file" id="imgUpload"name="imgupload"onchange="showPreview(this)"  value="@Model.ImageName"/>

                @Html.ValidationMessageFor(model => model.ImageName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-success p-1" />
            </div>
        </div>
    </div>
}

<div>
     @Html.ActionLink("صفحه لیست", "Index", null, new { @class = "btn btn-sm btn-outline-primary ms-1 p-1" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
