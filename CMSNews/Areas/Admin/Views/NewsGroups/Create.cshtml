@model CMSNews.Models.ViewModels.NewsGroupsViewModel

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>


@using (Html.BeginForm("Create", "NewsGroups", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>NewsGroup</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


        <div class="mb-3">
            @Html.LabelFor(model => model.NewsGroupTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NewsGroupTitle, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NewsGroupTitle, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.ImageName, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <img src="~/Images/news.group/nophoto.png" id="imgPrev" class="img60" alt="Alternate Text" />
                @*<input type="file" id="imgUpload"name="imgupload"onchange="showPreview(this)"  value="nophoto.png"/>*@

                <input type="file"
                       id="imgUpload"
                       name="imgUpload"
                       onchange="showPreview(this)" />


                                    @Html.ValidationMessageFor(
                       model => model.ImageName,
                       "",
                       new { @class = "text-danger" }
                    )


                @*@Html.EditorFor(model => model.ImageName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.ImageName, "", new { @class = "text-danger" })*@
            </div>
        </div>

        <div class="mb-3">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="ثبت" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("بازگشت به فهرست", "Index")
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



