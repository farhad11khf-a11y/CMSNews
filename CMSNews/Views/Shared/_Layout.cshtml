

@using System.Web.Optimization;
@using CMSNews.Models.Context
@using CMSNews.Service.Service
@using System.Linq

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title </title>
    @Styles.Render("~/Content/MyStyle")

    <link href="~/Content/slider-style.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="https://use.fontawesome.com/releases/v5.0.4/css/all.css" rel="stylesheet">
</head>
<body dir="rtl">
   
    @Html.Partial("_Navbar")
    <div class="container body-content">
        @RenderBody()
        

    </div>


    

   @Html.Partial("_Footer")


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/Bundle/MyScript")
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/slider-script.js"></script>


</body>
</html>