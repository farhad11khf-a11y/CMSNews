

@using System.Web.Optimization;
@using CMSNews.Models.Context
@using CMSNews.Service.Service
@using System.Linq

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title </title>
    @Styles.Render("~/Content/MyStyle")

    <link href="~/Content/slider-style.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="https://use.fontawesome.com/releases/v5.0.4/css/all.css" rel="stylesheet">
</head>
<body dir="rtl">
    @{
        string userName = "";
        string userImage = "nophoto.png";


        if (User.Identity.IsAuthenticated)
        {
            using (var db = new DbCMSNewsContext())
            {
                var userService = new UserService(db);

                var currentUser = userService.GetAll()
                    .FirstOrDefault(x => x.MobileNumber == User.Identity.Name);

                if (currentUser != null)
                {
                    userName = currentUser.FirstName + " " + currentUser.LastName;
                    userImage = currentUser.ImageName;
                }
            }
        }
    }

    <nav class="navbar navbar-expand-lg fixed-top">
        <a href="@Url.Action("Index", "Home")">
            <img src="~/Images/logo/0.png"
                 alt="Beauty"
                 class="navbar-logo" />
        </a>
        <a class="navbar-brand" href="#">وبسایت خبری درسمن</a>
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>


        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto">
                <li class="nav-item active">
                    <a class="nav-link" href="/">خانه <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#article-group">گروه اخبار</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#authors">نویسندگان</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#aboutUs">درباره ما</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contactUs">تماس با ما</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto align-items-center user-menu">

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center"
                           href="@Url.Action("MyProfile", "Account")">

                            <img src="@Url.Content("~/Images/users/" + userImage)"
                                 alt="تصویر پروفایل"
                                 width="35"
                                 height="35"
                                 class="rounded-circle"
                                 style="object-fit: contain; margin-left: 5px;" />

                            <span>@userName</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Logout", "Account")">
                            <i class="fas fa-sign-out-alt"></i>
                            خروج
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Login", "Account")">
                            <i class="fas fa-sign-in-alt"></i>
                            ورود به حساب
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Register", "Account")">
                            <i class="fas fa-user-plus"></i>
                            ثبت‌نام
                        </a>
                    </li>
                }
            </ul>
            @*<ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="pages/accounting.html">ورود | ثبت نام</a>
                    </li>
                </ul>*@
        </div>
    </nav>

