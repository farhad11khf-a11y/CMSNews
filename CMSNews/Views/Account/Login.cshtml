
@model CMSNews.Models.ViewModels.LoginViewModel
@using System.Web.Optimization

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

    <meta name="viewport" content="width=device-width" />

    <title>ورود</title>

    @Styles.Render("~/Content/MyStyle")

</head>

<body class="login-theme">

    <main>

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-md-5 col-lg-4">

                    <div class="card mt-5 shadow">

                        <div class="card-body p-4 py-5 ">

                            <!-- عنوان -->

                            <div class="text-center mb-4">

                                <h3>
                                    ورود به حساب کاربری
                                </h3>

                                <p class="text-muted">
                                    شماره موبایل و رمز عبور خود را وارد کنید
                                </p>

                            </div>


                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                @Html.HiddenFor(model => model.ReturnUrl)


                                <!-- Validation Summary -->

                                @Html.ValidationSummary(true, "",   new { @class = "text-danger mb-3" } )

                                <!-- MobileNumber -->

                                <div class="mb-3">

                                    @Html.LabelFor(model => model.MobileNumber, new { @class = "form-label" })

                                    @Html.EditorFor(model => model.MobileNumber, 
                                   new{ htmlAttributes = new { @class = "form-control bg-light", placeholder = "شماره موبایل" } })

                                    @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                </div>


                                <!-- Password -->

                                <div class="mb-3">

                                    @Html.LabelFor(model => model.Password, new { @class = "form-label" })

                                    @Html.PasswordFor(model => model.Password, new { @class = "form-control bg-light", placeholder = "رمز عبور" })

                                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })

                                </div>


                                <!-- RememberMe -->

                                <div class="mb-3">

                                    <div class="form-check">

                                        @Html.CheckBoxFor(model => model.RememberMe, new { @class = "form-check-input" })

                                        @Html.LabelFor(model => model.RememberMe, "مرا به خاطر بسپار", new { @class = "form-check-label" })

                                    </div>

                                </div>


                                <!-- Login Button -->

                                <div class="d-grid">

                                    <button class="btn btn-primary w-100" type="submit">
                                        ورود
                                    </button>

                                </div>

                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <!-- JavaScript -->

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Bundle/MyScript")

</body>

</html>
```
